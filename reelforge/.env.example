# --- Writing (must match generate.provider in config.yaml) ---
# Free, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Image hosting (Instagram fetches slides from public URLs) ---
# Free key: https://api.imgbb.com/
IMGBB_API_KEY=
# Or the github uploader instead:
GITHUB_TOKEN=
GITHUB_IMAGE_REPO=
GITHUB_IMAGE_BRANCH=main

# --- Instagram publishing ---
# Numeric Instagram Professional account id
IG_USER_ID=
# Long-lived access token with instagram_business_content_publish
IG_ACCESS_TOKEN=
# App id and secret from your Meta app. Without these the token cannot be
# auto-refreshed and posting will silently stop after ~60 days.
IG_APP_ID=
IG_APP_SECRET=

# --- Optional ---
# Only if playwright cannot find its own chromium
CHROMIUM_PATH=
